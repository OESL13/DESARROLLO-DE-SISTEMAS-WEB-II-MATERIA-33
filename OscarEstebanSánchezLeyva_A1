IF EXISTS (SELECT name FROM sys.databases WHERE name = 'TiendaSara')
BEGIN
    ALTER DATABASE TiendaSara SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
    DROP DATABASE TiendaSara;
END;
GO

CREATE DATABASE TiendaSara;
GO

USE TiendaSara;
GO

CREATE TABLE Categorías
(
    Id INT IDENTITY(1,1) PRIMARY KEY,
    Descripcion VARCHAR(100) NOT NULL
);
GO

CREATE TABLE Marca
(
    Id INT IDENTITY(1,1) PRIMARY KEY,
    Descripcion VARCHAR(100) NOT NULL
);
GO

CREATE TABLE Producto
(
    Id INT IDENTITY(1,1) PRIMARY KEY,
    Descripcion VARCHAR(150) NOT NULL,
    Precio DECIMAL(10,2) NOT NULL CHECK (Precio >= 0),
    Cantidad INT NOT NULL CHECK (Cantidad >= 0),
    idCategoria INT NOT NULL,
    idMarca INT NOT NULL,

    CONSTRAINT FK_Productos_Categorias
        FOREIGN KEY (idCategoria)
        REFERENCES Categorias(Id),

    CONSTRAINT FK_Productos_Marcas
        FOREIGN KEY (idMarca)
        REFERENCES Marcas(Id)
);
GO

CREATE TABLE Carrito
(
    Id INT IDENTITY(1,1) PRIMARY KEY,
    FolioVenta VARCHAR(50) NOT NULL UNIQUE,
    TotalCompra DECIMAL(10,2) NOT NULL DEFAULT 0.00
        CHECK (TotalCompra >= 0),
    Estatus VARCHAR(30) NOT NULL DEFAULT 'Pendiente'
);
GO

CREATE TABLE CarritoDetalle
(
    Id INT IDENTITY(1,1) PRIMARY KEY,
    IdCarrito INT NOT NULL,
    IdProducto INT NOT NULL,
    Cantidad INT NOT NULL CHECK (Cantidad > 0),
    Subtotal DECIMAL(10,2) NOT NULL CHECK (Subtotal >= 0),

    CONSTRAINT FK_Detalle_Carrito
        FOREIGN KEY (IdCarrito)
        REFERENCES Carrito(Id),

    CONSTRAINT FK_Detalle_Productos
        FOREIGN KEY (IdProducto)
        REFERENCES Productos(Id)
);
GO

